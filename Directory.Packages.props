<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the "Transitive pins" below override versions that packages bring in -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production packages -->
    <PackageVersion Include="HtmlAgilityPack" Version="1.11.63" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1" />
    <PackageVersion Include="dotenv.net" Version="3.1.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.4.0" />

    <!-- Transitive pins: patched versions of packages that others bring in with a known vulnerability -->
    <!-- via Microsoft.EntityFrameworkCore.Sqlite (Microsoft.Data.Sqlite 10.0.1 uses SQLitePCLRaw 2.1.x); 2.1.11 has GHSA-2m69-gcr7-jv3q -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <!-- via Microsoft.EntityFrameworkCore.Design (MSBuild); 9.0.0 has GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- via Microsoft.EntityFrameworkCore.Design (MSBuild) into FlatMonitor.Tests; the app gets it from the framework -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />

    <!-- Test packages -->
    <PackageVersion Include="NUnit" Version="4.1.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageVersion Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
