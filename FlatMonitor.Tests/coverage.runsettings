<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage of the backend tests, used by scripts/ci/backend-test.sh (CI). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Read by ReportGenerator, GitLab's MR coverage view and the job summaries -->
          <Format>cobertura</Format>
          <!-- The app only, not the test project or third-party assemblies -->
          <Include>[FlatMonitor]*</Include>
          <!-- Generated by EF Core, not written by hand -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
